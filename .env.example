NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-side only. Never prefix with NEXT_PUBLIC_ and never import in client code.
SUPABASE_SERVICE_ROLE_KEY=

# Server-side only. YouTube Data API key for the homepage Live & Recent Streams
# section. Never prefix with NEXT_PUBLIC_ or use in client components.
YOUTUBE_API_KEY=

# Server-side only. Resend for donation form submissions. Never prefix with NEXT_PUBLIC_.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
DONATION_NOTIFICATION_EMAIL=

# Optional. Set to false/0 to disable the courtesy auto-reply sent to the donor
# after a successful submission (enabled by default).
DONATION_AUTO_REPLY_ENABLED=

# --- MASOM Assistant (AI support agent) -------------------------------------
# Server-side only. Never prefix with NEXT_PUBLIC_ or read these in client code.
# The assistant serves its CMS fallback message when OPENROUTER_API_KEY is unset.
OPENROUTER_API_KEY=
AI_PROVIDER=openrouter
AI_BASE_URL=https://openrouter.ai/api/v1
AI_MODEL=deepseek/deepseek-v4-flash-0731:free
